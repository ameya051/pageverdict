# Google Gemini
GEMINI_API_KEY=AIza...

# NeonDB (serverless Postgres) - get from Neon console -> Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary - get from Cloudinary console -> Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google PageSpeed Insights API key (optional but strongly recommended for automated scans)
# Without a key the app still works, but Google may rate-limit requests much more aggressively.
# PAGESPEED_API_KEY=AIza...

# CORS - JSON array of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# Debug mode (enables hot reload, verbose logging)
DEBUG=false
