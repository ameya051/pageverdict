# Google Gemini
GEMINI_API_KEY=AIza...

# NeonDB (serverless Postgres) — get from Neon console → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary — get from Cloudinary console → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google PageSpeed Insights API key (optional — works without it but lower rate limits)
# PAGESPEED_API_KEY=AIza...

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# Debug mode (enables hot reload, verbose logging)
DEBUG=false
